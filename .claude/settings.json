{
  "permissions": {
    "allow": [
      "Bash(bin/factory:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(git reset --hard:*)",
      "Edit(factory/state/**/job.json)",
      "Write(factory/state/**/job.json)"
    ]
  }
}
