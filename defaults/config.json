{
  "$comment": "Forgeline defaults. Override in ~/.config/forgeline/config.json (you) or <repo>/.factory/config.json (this app).",
  "concurrency": 3,
  "default_max_attempts": 3,
  "lock_timeout_minutes": 90,

  "models": {
    "default": "sonnet",
    "intake": "sonnet",
    "spec-writer": "opus",
    "backend-builder": "opus",
    "frontend-builder": "opus",
    "unit-test-engineer": "sonnet",
    "e2e-test-engineer": "sonnet",
    "security-engineer": "sonnet",
    "code-reviewer": "opus",
    "security-reviewer": "sonnet",
    "ux-reviewer": "haiku",
    "approver": "opus",
    "qa-validator": "sonnet"
  },

  "policy": {
    "auto_merge_max_risk": "low",
    "require_all_reviewers_pass": true,
    "require_gate_on_head": true,
    "protected_paths": ["**/migrations/**", ".github/workflows/**", "**/auth/**", "**/*.tf", ".factory/**"]
  },

  "runner": {
    "default": "claude",
    "timeout_minutes": 45,
    "claude": { "permission_mode": "acceptEdits" },
    "codex": { "sandbox": "workspace-write", "model": null }
  }
}
